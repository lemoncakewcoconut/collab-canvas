{
  "name": "collab-canvas-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CollabCanvas: Real-Time Collaborative Infinite Canvas (OneNote + Excalidraw / Miro)",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=client",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "start": "node server/dist/index.js"
  },
  "keywords": [
    "canvas",
    "infinite-canvas",
    "crdt",
    "yjs",
    "collaborative",
    "whiteboard",
    "onenote"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.1",
    "typescript": "^5.7.3"
  }
}
